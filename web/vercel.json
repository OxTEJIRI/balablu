{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/((?!api/|js/|vendor/|content/|styles.css|favicon.svg|llms.txt).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(js|vendor)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] }
  ]
}
